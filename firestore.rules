rules_version = '2';

// All licensing data is read and written exclusively by Cloud Functions
// using the Admin SDK (which bypasses these rules). No client - not the
// Flutter POS app, not the admin panel - ever talks to Firestore directly,
// so every authorization decision lives in exactly one place: the Functions
// handlers. Direct client access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
