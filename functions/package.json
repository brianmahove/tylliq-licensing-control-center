{
  "name": "shopsync-licensing-functions",
  "description": "Licensing backend for ShopSync POS (Tylliq) - Ed25519 signing, device activation, admin API.",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "logs": "firebase functions:log",
    "cli": "node scripts/admin_cli.js",
    "seed-demo": "node scripts/seed_demo_data.js",
    "gen-keypair": "node scripts/generate_signing_keypair.js",
    "set-admin": "node scripts/set_admin_claim.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "src/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
